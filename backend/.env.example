# 物理实验调课辅助系统 — 生产/部署环境配置骨架（模板）
#
# 用法：
#   1. 复制为 backend/.env（或项目根 .env），按需填值后启动。
#   2. 变量优先级（见 backend/app/__init__.py）：真实环境变量  >  .env  >  env.local
#   3. APP_NO_ENV_FILE=1 可完全跳过 .env 文件加载，仅用真实环境变量。
#
# ⚠️ 本文件是"骨架/模板"，不含真实密钥，会被纳入版本控制 —— 不要把真实密钥写进来后提交。
# ⚠️ 真实运行配置在 env.local（由 scripts/write_local_config.py 生成，含明文密钥，已 gitignore，勿提交）。

# ============ 服务监听 ============
HOST=0.0.0.0
# 生产/一键启动脚本(start.ps1)实际使用 9000（规避 Hyper-V 动态保留段无法 bind）；
# uvicorn 默认 8000；测试/prepare_demo 常指定 8023。三者并存是历史约定，改前先读 vite.config.ts 注释。
PORT=9000
# 前端构建产物目录（FastAPI 同源托管）。npm run build 输出到 frontend/webui。
FRONTEND_DIST=frontend/webui
# 关闭 Swagger /docs（生产建议设 1）
DISABLE_DOCS=0
# 慢请求日志阈值（毫秒），超过则记告警
SLOW_REQUEST_MS=1000
# 公开只读接口总开关（默认开；设 0 关闭 /api 的公开只读查询）
PUBLIC_READONLY=1

# ============ 管理员会话 ============
APP_ENV=development
# 生产环境务必改为 >=16 位强口令；security.py 在 APP_ENV=production 且无强口令时拒绝启动。
ADMIN_USER=admin
ADMIN_PASS=change-me-to-strong-pass-in-production
# 会话签名密钥：设置了则服务重启后管理员登录态仍有效；不设则每次启动随机生成（演示可省）。
APP_SECRET_KEY=
# 令牌有效期（秒），默认 8 小时
ADMIN_TOKEN_TTL=28800

# ============ 排课人员(scheduler)角色 — R-95 ============
SCHEDULER_USER=
SCHEDULER_PASS=

# ============ 演示态 ============
# 设 1 进入演示态：仅演示态允许默认弱口令 admin/admin123，并开放 /demo/* 复位接口。
# 生产务必为 0 或留空。
DEMO_MODE=0

# ============ LLM / AI Agent（可选）============
# 设 LLM_DISABLED=1 可关闭意图解析等 AI 功能（不影响核心排课）。
LLM_DISABLED=0
LLM_PROVIDER=zhipu
LLM_API_KEY=
LLM_API_BASE=
LLM_MODEL=
# 各渠道密钥（按 LLM_PROVIDER 选用其一即可）
ZHIPU_API_KEY=
MODELSCOPE_API_KEY=
DEEPSEEK_API_KEY=

# ============ 排课求解引擎 ============
# 后台预热线程：默认开；测试/CI 必须设 0（见 conftest）。
SCHEDULE_WARMUP=1
# CP-SAT worker 数；留空由求解器自定。
SOLVER_WORKERS=
# 覆盖排课数据源路径（默认按代码内定表）。
SCHEDULE_PATH=

# ============ 数据 / 解析 ============
# 持久化数据目录（留空用代码默认 → backend/app/data）
#
# 填了就必须是**当前平台认可的绝对路径**：Windows 上 `/home/user/psa-data`
# 这种 POSIX 路径会被判为不可用并静默回退（R-113 修的就是这个 —— 修之前它会在
# 盘根建出 E:\home\user\psa-data，数据落到谁都找不到的地方）。
# 沙箱（Linux）照常可写 /home/user/psa-data。
PSA_DATA_DIR=
# 上传文件大小上限（MB）
MAX_UPLOAD_MB=32
# 单表最大行数
MAX_SHEET_ROWS=20000
# 解析缓存开关与目录
PARSE_CACHE=1
PARSE_CACHE_DIR=

# ============ 限流 / 调试 ============
RATELIMIT_DISABLED=0
APP_CONFIG_DEBUG=0
APP_NO_ENV_FILE=0

# ============ 性能（非应用直接读取，由启动脚本注入）============
# numpy/OpenBLAS 在机器紧时导入易失败，启动一律单线程。
OPENBLAS_NUM_THREADS=1
